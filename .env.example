# Supabase pooler connection (session mode, port 5432) — direct connection
# (db.<ref>.supabase.co) is IPv6-only and won't resolve on most local networks.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_CLIENT_TOKEN=test_your_client_side_token
PADDLE_API_KEY=pdl_sdbx_replace_me
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace_me
PADDLE_PRO_MONTHLY_PRICE_ID=pri_replace_me
PADDLE_PRO_YEARLY_PRICE_ID=pri_replace_me
PADDLE_TEAM_YEARLY_PRICE_ID=pri_replace_me
APP_URL=http://localhost:5173
# Browser-facing PostHog project token. Keep disabled locally unless you are
# intentionally validating analytics; this integration sends only explicit,
# anonymous product events and does not enable session replay.
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Threads daily palette marketing. Keep disabled until a Meta app has authorized
# the account with threads_basic, threads_content_publish, and threads_manage_insights.
THREADS_MARKETING_ENABLED=false
THREADS_ACCESS_TOKEN=
# Must be public HTTPS; Threads fetches generated SVG images from this origin.
THREADS_PUBLIC_IMAGE_ORIGIN=https://vitrines.ai
THREADS_DAILY_TIME=09:00
THREADS_TIME_ZONE=Asia/Ho_Chi_Minh
# Password-reset email through Resend. Use an API key with send-email access
# and a sender address/domain verified in Resend; keep both server-side only.
RESEND_API_KEY=
EMAIL_FROM=Vitrines <security@vitrines.ai>
# Shared by the API and collaboration gateways. Generate with: openssl rand -hex 32
JWT_SIGNING_SECRET=replace-with-at-least-32-random-characters
# Optional. Defaults to APP_URL and "vitrines" respectively.
JWT_ISSUER=
JWT_AUDIENCE=vitrines
# Set these to the actual launch window before deploying. The initial campaign is 90 days.
REFERRAL_CAMPAIGN_ID=launch-2026
REFERRAL_CAMPAIGN_START=2026-07-21T00:00:00Z
REFERRAL_CAMPAIGN_END=2026-10-19T00:00:00Z
MEDIA_SIGNING_SECRET=replace-with-at-least-32-random-characters
# Generate with: openssl rand -base64 32
CRAWL_SESSION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
CRAWL_WORKER_ID=import-worker-1
CRAWL_STALE_RUN_THRESHOLD_MS=300000
CHAT_PROFILE_ROOT=
HEADLESS=true
APP_KNOWLEDGE_PROVIDER=chatgpt-browser
APP_KNOWLEDGE_BROWSER_CONCURRENCY=1
GENERAL_RATE_LIMIT=300
MEDIA_RATE_LIMIT=500
APP_TRAVERSAL_LIMIT=20
# Personal designer Research Projects and durable Flow-to-Feature-Document
# generation only. App Knowledge uses the dedicated ChatGPT browser settings above.
RESEARCH_PROJECTS_ENABLED=false
VITE_RESEARCH_PROJECTS_ENABLED=false
# Enables Team creation, membership management, and Team-owned Projects.
TEAMS_ENABLED=false
# Hocuspocus collaboration service. In production, use the exact public app
# origin; in local development APP_URL is used when this is empty.
PROJECT_DOCUMENT_COLLAB_ALLOWED_ORIGINS=
PROJECT_DOCUMENT_COLLAB_HOST_PORT=3013
VITRINE_PROJECT_DOCUMENT_COLLAB_TARGET=http://127.0.0.1:3013
# Server/worker only. Never expose these values through VITE_* variables.
RESEARCH_LLM_BASE_URL=https://api.openai.com/v1
RESEARCH_LLM_API_KEY=
RESEARCH_LLM_MODEL=

# Adaptive catalog search. Keep both flags disabled until indexing, relevance,
# and performance gates pass. The embedding key is server/worker-only.
ADVANCED_SEARCH_ENABLED=false
VITE_ADVANCED_SEARCH_ENABLED=false
SEARCH_EMBEDDING_BASE_URL=https://api.openai.com/v1
SEARCH_EMBEDDING_API_KEY=
SEARCH_EMBEDDING_MODEL=text-embedding-3-small
SEARCH_INDEX_WORKER_ID=

# Typesense powers the legacy /api/search fast path. Keep disabled until a backfill
# has completed. These values are server/worker-only; never expose the API key via VITE_*.
TYPESENSE_SEARCH_ENABLED=false
TYPESENSE_HOST=http://10.104.0.3:8108
TYPESENSE_API_KEY=
TYPESENSE_COLLECTION=vitrines_catalog_v1
