2a:["$","$L30",null,{"as":"div","splitSelector":"[data-text]","className":"flex w-full flex-col gap-[1em] [&_[data-text]>*:not(:first-child)]:indent-0","children":[["$","div","44587423753e",{"className":"empty:h-[1lh]","data-text":true,"children":["License, payment, and use of The Content Architecture. Last updated August 2026."]}],["$","div","b35b58690ad8",{"className":"empty:h-[1lh]","data-text":true,"children":["These terms govern your purchase and use of The Content Architecture, a source-code product sold by Edoardo Lunardi, a sole trader based in Vienna, Austria. By buying, you agree to them."]}],["$","h2","930533e356ed",{"className":"text-[145%] [&:not(:first-child)]:mt-[1.2em]","data-text":true,"children":["What you are buying"]}],["$","div","1ca0dc3f3adf",{"className":"empty:h-[1lh]","data-text":true,"children":["A perpetual license to use the source code of the edition or editions of The Content Architecture you purchased. Access is delivered by granting the GitHub account you provide at checkout access to the private repository of each purchased edition, through a GitHub organization invitation if that account is not already a member. The purchase is for the code and the right to use it, not for any service, support level, or guaranteed outcome."]}],["$","h2","57b284b07910",{"className":"text-[145%] [&:not(:first-child)]:mt-[1.2em]","data-text":true,"children":["What the license allows"]}],["$","div","ca8a91962d88",{"className":"empty:h-[1lh]","data-text":true,"children":["You may use the code in unlimited personal and commercial projects, including paid client work. No attribution is required. You may modify it freely and ship it as part of the sites you build."]}],["$","div","4d5814f93f56",{"className":"empty:h-[1lh]","data-text":true,"children":["The license is granted to one buyer: a single person, or a single company if a company buys it. Repository access is for that buyer and the developers working directly for them on their own projects. It does not extend to separate legal entities, and you cannot hand your access to someone else so they can skip buying. If a larger team needs access, get in touch."]}],["$","div","c9b41e07af52",{"className":"empty:h-[1lh]","data-text":true,"children":["Client work includes handover. You may deliver a project built on the code to a client, source included, and the client may run, host, modify, and maintain that project indefinitely, including after your engagement ends. That is where the client's rights end: receiving a project is not a license to the architecture as a starter. To begin a new project from it, the client buys their own."]}],["$","h2","256f8220c7fc",{"className":"text-[145%] [&:not(:first-child)]:mt-[1.2em]","data-text":true,"children":["What the license does not allow"]}],["$","div","ef5d17f36fab",{"className":"empty:h-[1lh]","data-text":true,"children":["You may not resell, redistribute, sublicense, or publish the architecture itself, in whole or in substantial part, as a competing product, template, boilerplate, or course. The license is granted to you, the buyer. It is not for sharing repository access with people who have not bought it. The line is simple: build whatever you want with it, do not resell it as it is."]}],["$","h2","6ef22e48e2bc",{"className":"text-[145%] [&:not(:first-child)]:mt-[1.2em]","data-text":true,"children":["Payment and refunds"]}],["$","div","758f9ef783ca",{"className":"empty:h-[1lh]","data-text":true,"children":["Payment is processed by Stripe. Because the product is source code delivered on purchase, and access cannot be returned once granted, all sales are final and no refunds are offered. To help you decide before buying, the reasoning behind the architecture is published openly in the article series, the real repository is shown on the site, and live sites built on it are linked. If anything is unclear before you buy, email ","$L31",". Where mandatory consumer law grants a right that cannot be waived, that right is unaffected by this clause."]}],"$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a"]}]
