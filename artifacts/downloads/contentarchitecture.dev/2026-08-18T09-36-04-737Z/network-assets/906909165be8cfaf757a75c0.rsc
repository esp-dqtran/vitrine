b:[["$","title","0",{"children":"Privacy Policy | The Content Architecture"}],["$","meta","1",{"name":"description","content":"How The Content Architecture handles your data. What we collect, how Stripe processes payments, your GDPR rights, and how to reach us."}],["$","link","2",{"rel":"canonical","href":"https://www.contentarchitecture.dev/privacy-policy"}],["$","meta","3",{"property":"og:title","content":"Privacy Policy | The Content Architecture"}],["$","meta","4",{"property":"og:description","content":"How The Content Architecture handles your data. What we collect, how Stripe processes payments, your GDPR rights, and how to reach us."}],["$","meta","5",{"property":"og:url","content":"https://www.contentarchitecture.dev/privacy-policy"}],["$","meta","6",{"property":"og:site_name","content":"The Content Architecture"}],["$","meta","7",{"property":"og:image","content":"https://cdn.sanity.io/images/szlvuc1t/production/fa6b9eeac8902bc3b2f665b561ad188d9401256f-1920x1008.png?w=1200&h=630&q=85&fit=crop&auto=format"}],["$","meta","8",{"property":"og:type","content":"website"}],["$","meta","9",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","10",{"name":"twitter:title","content":"Privacy Policy | The Content Architecture"}],["$","meta","11",{"name":"twitter:description","content":"How The Content Architecture handles your data. What we collect, how Stripe processes payments, your GDPR rights, and how to reach us."}],["$","meta","12",{"name":"twitter:image","content":"https://cdn.sanity.io/images/szlvuc1t/production/fa6b9eeac8902bc3b2f665b561ad188d9401256f-1920x1008.png?w=1200&h=630&q=85&fit=crop&auto=format"}],["$","link","13",{"rel":"icon","href":"/favicon.ico"}],["$","link","14",{"rel":"icon","href":"https://cdn.sanity.io/images/szlvuc1t/production/c40bf16727173bad99888c2bfb3f2e69b92a62fc-800x800.png?w=64&h=64&fm=png&q=85&fit=crop","type":"image/png","media":"(prefers-color-scheme: light)"}],["$","link","15",{"rel":"icon","href":"https://cdn.sanity.io/images/szlvuc1t/production/fb5bfe82806b22de4ae481600887a65458496e5b-800x800.png?w=64&h=64&fm=png&q=85&fit=crop","type":"image/png","media":"(prefers-color-scheme: dark)"}],["$","$L27","16",{}]]
29:T1eaa,[{"_key":"ed7d35ac31ec","_type":"block","children":[{"_key":"f507dea55427","_type":"span","marks":[],"text":"How The Content Architecture handles your data. Last updated August 2026."}],"markDefs":[],"style":"normal"},{"_key":"a145b7a0ecff","_type":"block","children":[{"_key":"eb72c241a5f7","_type":"span","marks":[],"text":"This site is operated by Edoardo Lunardi, a sole trader based in Vienna, Austria. This policy explains what data is collected when you visit the site, sign up for updates, or buy The Content Architecture, why it is collected, and who it is shared with. It is written to be read, not to hide behind legal language."}],"markDefs":[],"style":"normal"},{"_key":"e9730e8ab6f9","_type":"block","children":[{"_key":"a09b8f227d81","_type":"span","marks":[],"text":"Who is responsible for your data"}],"markDefs":[],"style":"h2"},{"_key":"e91106c4ea32","_type":"block","children":[{"_key":"8a87bde77d22","_type":"span","marks":[],"text":"The data controller is Edoardo Lunardi. For any privacy question or request, contact "},{"_key":"2b0afe70c06f","_type":"span","marks":["ppEmail1"],"text":"hello@edoardolunardi.dev"},{"_key":"450508e909cb","_type":"span","marks":[],"text":"."}],"markDefs":[{"_key":"ppEmail1","_type":"linkField","canDownload":false,"email":"hello@edoardolunardi.dev","href":"mailto:hello@edoardolunardi.dev","openInNewTab":false,"showPulseDot":false,"text":"hello@edoardolunardi.dev","type":"email"}],"style":"normal"},{"_key":"edcfdab9b2b5","_type":"block","children":[{"_key":"e4ea785609aa","_type":"span","marks":[],"text":"What is collected, and why"}],"markDefs":[],"style":"h2"},{"_key":"8b35011f8e98","_type":"block","children":[{"_key":"c979d5078422","_type":"span","marks":[],"text":"Analytics. Page visits are measured with privacy-friendly, cookieless analytics that do not track you across sites and do not store personal information. No cookies are set for analytics, and there is no advertising or cross-site tracking anywhere on this site."}],"markDefs":[],"style":"normal"},{"_key":"4266219a27da","_type":"block","children":[{"_key":"9dc30c716191","_type":"span","marks":[],"text":"Purchase. When you buy, you check out on this site and payment is handled by Stripe. Stripe collects your payment details directly, such as your card, billing address, and IP, and runs its own fraud checks; card numbers never reach this site or its operator. Your approximate country, derived from your network address, is used to pre-select the billing country and is not stored. After a successful payment, what is stored here is your email address, the GitHub username you provided, which edition you bought, a Stripe reference for the transaction, the amount and currency, and the status of your repository access. This data exists so the purchase can be fulfilled and supported."}],"markDefs":[],"style":"normal"},{"_key":"5ab4868100e7","_type":"block","children":[{"_key":"364d906e13e8","_type":"span","marks":[],"text":"Repository access. At checkout you provide the GitHub username that should receive access. As you type it, it is checked against GitHub's public API so the account can be suggested and confirmed before you pay. After payment, that account is granted repository access directly, through a GitHub organization invitation if it is not already a member, and the username is stored with the purchase so access can be managed and supported."}],"markDefs":[],"style":"normal"},{"_key":"392f295c5bf4","_type":"block","children":[{"_key":"8a5b5cf58e0c","_type":"span","marks":[],"text":"Email updates. If you sign up through a form on the site, your email is added to a mailing list so you can be sent occasional updates about the product. When you buy, your email is also added to this list so you hear about updates and changes to what you bought. This is handled by Resend. The legal basis is your consent when you sign up, and a legitimate interest in telling existing buyers about the product they own. You can unsubscribe from any email, or by writing to "},{"_key":"fcade2bde1cb","_type":"span","marks":["ppEmailMkt"],"text":"hello@edoardolunardi.dev"},{"_key":"4b24dc4e07b2","_type":"span","marks":[],"text":", and you will be removed from the list."}],"markDefs":[{"_key":"ppEmailMkt","_type":"linkField","canDownload":false,"email":"hello@edoardolunardi.dev","href":"mailto:hello@edoardolunardi.dev","openInNewTab":false,"showPulseDot":false,"text":"hello@edoardolunardi.dev","type":"email"}],"style":"normal"},{"_key":"f070b371280e","_type":"block","children":[{"_key":"1d79eb2b8d46","_type":"span","marks":[],"text":"Contact. If you email or use a contact form, your message and email address are stored so the conversation can be answered and referred back to."}],"markDefs":[],"style":"normal"},{"_key":"083a6640f2aa","_type":"block","children":[{"_key":"7be1e6ac9fe2","_type":"span","marks":[],"text":"Who your data is shared with"}],"markDefs":[],"style":"h2"},{"_key":"02ce879bccbc","_type":"block","children":[{"_key":"d25dbc5cf67e","_type":"span","marks":[],"text":"Data is shared only with the services needed to run the product: Stripe for payments, GitHub for repository access and discussions, and Resend for transactional and update emails. Each processes data under its own privacy terms. Your data is never sold, rented, or shared for advertising."}],"markDefs":[],"style":"normal"},{"_key":"02478b7e4824","_type":"block","children":[{"_key":"6a958a0e672c","_type":"span","marks":[],"text":"International transfers. Stripe, GitHub, and Resend are based in the United States, so using the site and buying may involve transferring your data outside the EEA. These providers rely on standard data protection safeguards, such as the European Commission's standard contractual clauses, to protect it."}],"markDefs":[],"style":"normal"},{"_key":"1521042d82e6","_type":"block","children":[{"_key":"82c786c7a2bc","_type":"span","marks":[],"text":"How long it is kept"}],"markDefs":[],"style":"h2"},{"_key":"7980b5d588af","_type":"block","children":[{"_key":"6ebc7fc4afd9","_type":"span","marks":[],"text":"Purchase and access records are kept for as long as you hold a license, plus the period required by tax and accounting law. Mailing list entries are kept until you unsubscribe. Contact messages are kept only as long as useful for support. You can ask for your data to be deleted at any time, subject to records that must be retained by law."}],"markDefs":[],"style":"normal"},{"_key":"66cf8a019f96","_type":"block","children":[{"_key":"aa5eb4c31912","_type":"span","marks":[],"text":"Your rights"}],"markDefs":[],"style":"h2"},{"_key":"ea171976fe67","_type":"block","children":[{"_key":"e3b021724701","_type":"span","marks":[],"text":"Under the GDPR you can request access to your data, correction, deletion, or a copy in portable form, and you can object to certain processing or withdraw consent at any time. To exercise any of these, email "},{"_key":"bd14fc686e68","_type":"span","marks":["ppEmail2"],"text":"hello@edoardolunardi.dev"},{"_key":"a39a1d973d01","_type":"span","marks":[],"text":". You also have the right to complain to your local data protection authority."}],"markDefs":[{"_key":"ppEmail2","_type":"linkField","canDownload":false,"email":"hello@edoardolunardi.dev","href":"mailto:hello@edoardolunardi.dev","openInNewTab":false,"showPulseDot":false,"text":"hello@edoardolunardi.dev","type":"email"}],"style":"normal"},{"_key":"d6c3b93cb9af","_type":"block","children":[{"_key":"79f6950c63d5","_type":"span","marks":[],"text":"Changes to this policy"}],"markDefs":[],"style":"h2"},{"_key":"d3bb99950ec4","_type":"block","children":[{"_key":"93509f34c8aa","_type":"span","marks":[],"text":"If this policy changes, the date at the top is updated. Material changes affecting existing buyers will be communicated by email."}],"markDefs":[],"style":"normal"}]3:["$","div",null,{"className":"flex min-h-svh flex-col","children":[["$","header",null,{"data-studio-chrome":"showHeader","className":"pointer-events-none fixed inset-x-0 top-0 z-4 flex justify-start p-8 lg:justify-center lg:p-16","children":["$","$L28",null,{"links":[{"canDownload":false,"href":"/#features","openInNewTab":false,"showPulseDot":false,"text":"Features","type":"internal"},{"canDownload":false,"href":"/#the-repo","openInNewTab":false,"showPulseDot":false,"text":"The repo","type":"internal"},{"canDownload":false,"href":"/#showcase","openInNewTab":false,"showPulseDot":false,"text":"Showcase","type":"internal"},{"canDownload":false,"href":"/#pricing","openInNewTab":false,"showPulseDot":true,"text":"Pricing","type":"internal"},{"canDownload":false,"href":"/#faq","openInNewTab":false,"showPulseDot":false,"text":"FAQ","type":"internal"},{"canDownload":false,"href":"/blog","openInNewTab":false,"showPulseDot":false,"text":"Blog","type":"internal"}],"announcement":[{"_key":"38337a30eb02","_type":"block","children":[{"_key":"1e9c1c3e8b60","_type":"span","marks":[],"text":"Now available with Astro"}],"markDefs":[],"style":"normal"}]}]}],["$","main",null,{"className":"relative z-1 flex flex-1 flex-col bg-black [&>*:first-child]:flex-1","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://www.contentarchitecture.dev/privacy-policy#webpage\",\"url\":\"https://www.contentarchitecture.dev/privacy-policy\",\"name\":\"Privacy Policy | The Content Architecture\",\"description\":\"How The Content Architecture handles your data. What we collect, how Stripe processes payments, your GDPR rights, and how to reach us.\",\"isPartOf\":{\"@id\":\"https://www.contentarchitecture.dev/#website\"},\"about\":{\"@id\":\"https://www.contentarchitecture.dev/#organization\"},\"inLanguage\":\"en\"},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.contentarchitecture.dev/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Privacy Policy\",\"item\":\"https://www.contentarchitecture.dev/privacy-policy\"}]}]}"}}],[["$","div","d72af1667b7e",{"data-page-builder-section":"textSection","className":"bg-black px-16 py-100 text-white lg:px-80 lg:py-160","children":["$","div",null,{"className":"mx-auto flex max-w-800 flex-col","children":[["$","h1",null,{"data-studio-field":"title","className":"mb-48 text-balance font-medium text-headline-10","children":"Privacy Policy"}],["$","div",null,{"data-studio-field":"appRichText","className":"w-full text-body-20","children":[["$","script",null,{"type":"application/json","data-studio-rich-text":true,"dangerouslySetInnerHTML":{"__html":"$29"}}],"$L2a"]}]]}]}]],"$L2b","$L2c","$L2d","$L2e"]}],"$L2f"]}]
